# For running the backend directly (no Docker), e.g.:
#   cd backend && uv sync && uv run uvicorn app.main:app --reload
# Usage: cp .env.example .env, then: set -a; source .env; set +a

DATABASE_URL=postgresql://baby:baby@localhost:5432/baby_marks
APP_SECRET_PHRASE=change-me

# Keep false on plain HTTP (local dev) — the browser drops the auth cookie if this
# is true and the connection isn't HTTPS. Set true only behind TLS (e.g. Traefik).
COOKIE_SECURE=false

# MCP server (claude.ai connector) — see README "MCP server (claude.ai connector)".
MCP_ACCESS_SECRET=change-me-mcp        # password on the /authorize form; rotate either MCP secret to revoke claude.ai access
MCP_JWT_SECRET=change-me-mcp-jwt       # signs MCP access/refresh tokens; rotate either MCP secret to revoke claude.ai access
MCP_PUBLIC_URL=http://localhost:8000   # externally-reachable origin serving /mcp (no trailing slash)
MCP_DEFAULT_TIMEZONE=Europe/Paris      # IANA tz name used when the MCP client doesn't supply one
