# DOMAIN=baby.yourdomain.com
# POSTGRES_PASSWORD=generate-a-long-random-password
# APP_SECRET_PHRASE=shared-secret-both-parents-use-to-log-in

# Optional overrides:
# POSTGRES_USER=baby
# POSTGRES_DB=baby_marks
