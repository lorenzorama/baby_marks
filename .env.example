# This file is for `docker compose up` (local) and `docker compose -f docker-compose.prod.yml up`
# (VPS) — copy to `.env` at the repo root, which Docker Compose reads automatically.
#
# Running the backend directly without Docker? Use backend/.env.example instead.

# ── Local dev (docker compose up) ─────────────────────────────────────────────

APP_SECRET_PHRASE=change-me

# COMPOSE_PROJECT_NAME=babymarks  # required by docker-compose.prod.yml Traefik router names on older compose versions

# MCP (claude.ai connector) dev defaults below already work out of the box —
# override if you want to test the connector flow locally:
# MCP_ACCESS_SECRET=change-me-mcp        # password on the /authorize form
# MCP_JWT_SECRET=change-me-mcp-jwt       # signs MCP access/refresh tokens — rotate either MCP secret to revoke claude.ai access
# MCP_PUBLIC_URL=http://localhost:8000
# MCP_DEFAULT_TIMEZONE=Europe/Paris

# ── Production (docker compose -f docker-compose.prod.yml up -d --build) ──────
# Required on Hostinger VPS:

# DOMAIN=baby.yourdomain.com
# POSTGRES_PASSWORD=generate-a-long-random-password
# APP_SECRET_PHRASE=shared-secret-both-parents-use-to-log-in
# MCP_ACCESS_SECRET=<long-random-secret>   # password claude.ai uses to authorize the connector
# MCP_JWT_SECRET=<long-random-secret>      # signs MCP tokens — rotate either MCP secret to revoke claude.ai access
# MCP_PUBLIC_URL=https://baby.yourdomain.com   # must match DOMAIN above, with scheme

# Optional overrides:
# POSTGRES_USER=baby
# POSTGRES_DB=baby_marks
# MCP_DEFAULT_TIMEZONE=Europe/Paris   # IANA tz name used when the MCP client doesn't supply one
