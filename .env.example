# This file is for `docker compose up` (local) and `docker compose -f docker-compose.prod.yml up`
# (VPS) — copy to `.env` at the repo root, which Docker Compose reads automatically.
#
# Running the backend directly without Docker? Use backend/.env.example instead.

# ── Local dev (docker compose up) ─────────────────────────────────────────────

APP_SECRET_PHRASE=change-me

# COMPOSE_PROJECT_NAME=babymarks  # required by docker-compose.prod.yml Traefik router names on older compose versions

# ── Production (docker compose -f docker-compose.prod.yml up -d --build) ──────
# Required on Hostinger VPS:

# DOMAIN=baby.yourdomain.com
# POSTGRES_PASSWORD=generate-a-long-random-password
# APP_SECRET_PHRASE=shared-secret-both-parents-use-to-log-in

# Optional overrides:
# POSTGRES_USER=baby
# POSTGRES_DB=baby_marks
